# Postgres connection string — free tiers work fine to start (Supabase, Neon, Railway)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="run: openssl rand -base64 32"

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (dashboard.stripe.com -> Developers -> API keys)
# Use test keys (sk_test_... / pk_test_...) until you're ready to go live.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` while developing,
# or from the webhook endpoint you create in the Stripe dashboard for production.
STRIPE_WEBHOOK_SECRET=""

# Resend (resend.com) — used for offer/review/sale email notifications.
# Optional: if left blank, in-app notifications (bell icon) still work,
# emails are just skipped.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Voltra <onboarding@resend.dev>"
